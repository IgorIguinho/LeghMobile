%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361208f872750c74cbc021f057b1502a, type: 3}
  m_Name: D4 - Encerramento
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogues:
  - speakerName: Chiquinha Gonzaga
    dialogueText: "Minha partitura! N\xE3o consigo acreditar que meus arranjos est\xE3o
      a salvo!"
    speakerPortrait: {fileID: 0}
  - speakerName: Chiquinha Gonzaga
    dialogueText: "Queriam me impedir de ditar o ritmo da orquestra, mas voc\xEA
      devolveu a melodia ao meu espet\xE1culo. Muito obrigada!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "A hist\xF3ria precisa da sua m\xFAsica."
    speakerPortrait: {fileID: 0}
  - speakerName: Chiquinha Gonzaga
    dialogueText: "Ela vai ecoar, pois a arte e a liberdade t\xEAm um compasso que
      ningu\xE9m consegue parar. Obrigada, mais uma vez!"
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Bom trabalho! O concerto de hoje est\xE1 salvo! Mas espere...
      estou detectando algo errado nos relat\xF3rios de dados!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: Explique.
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Fez um \xF3timo trabalho, mas a aventura no Rio de Janeiro est\xE1
      s\xF3 come\xE7ando! Mesmo salvando este show, algumas partituras foram roubadas
      e espalhadas. O legado de Maria Felipa ainda corre risco se n\xE3o coletarmos
      todos os registros.!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "Rastrear assinaturas t\xE9rmicas."
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Imposs\xEDvel, pois detectei atividade de um soldado de alto escal\xE3o
      do General Calvil em outra fenda. Temos que nos mover imediatamente para 1887,
      antes que o fluxo temporal fique completamente inst\xE1vel!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: Preparar salto.
    speakerPortrait: {fileID: 0}
  LastDialogue: 1
