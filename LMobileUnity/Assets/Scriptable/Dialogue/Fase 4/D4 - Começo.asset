--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361208f872750c74cbc021f057b1502a, type: 3}
  m_Name: "D4 - Come\xE7o"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogues:
  - speakerName: "Rel\xF3gio"
    dialogueText: "Salto de emerg\xEAncia conclu\xEDdo! Rio de Janeiro, 1880!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "Status da situa\xE7\xE3o?"
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Os Rubros invadiram o sal\xE3o da lend\xE1ria maestrina e compositora
      Chiquinha Gonzaga!"
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Ela est\xE1 prestes a fazer hist\xF3ria na m\xFAsica brasileira,
      mas Calvil quer silenci\xE1-la, roubando suas partituras pelo fluxo temporal!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "Onde est\xE1 o Rubro que fez isso?"
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Olha l\xE1, deve ser aquela pessoa de vermelho."
    speakerPortrait: {fileID: 0}
  - speakerName: Rubro
    dialogueText: "Olha s\xF3 o que temos aqui... O agentezinho da guarda do tempo
      chegou tarde! Uma mulher liderando orquestras e compondo? Que absurdo! Essas
      m\xFAsicas agora pertencem ao vento!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: Devolva as partituras.
    speakerPortrait: {fileID: 0}
  - speakerName: Rubro
    dialogueText: Nunca! HAHAHAHAHA!
    speakerPortrait: {fileID: 0}
  - speakerName: "Rel\xF3gio"
    dialogueText: "Voc\xEA precisa agir r\xE1pido, ele est\xE1 fugindo com a partitura
      principal, Agente! N\xE3o o perca de vista e use tudo o que aprendeu para captur\xE1-lo!"
    speakerPortrait: {fileID: 0}
