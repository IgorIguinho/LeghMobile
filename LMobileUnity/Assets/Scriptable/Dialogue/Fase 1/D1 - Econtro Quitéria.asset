  m_Script: {fileID: 11500000, guid: 361208f872750c74cbc021f057b1502a, type: 3}
  m_Name: "D1 - Econtro Quit\xE9ria"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogues:
  - speakerName: "Maria Quit\xE9ria"
    dialogueText: "Volte para o abrigo, o Rec\xF4ncavo Baiano virou um inferno!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: Vim tentar parar o General Calvil.
    speakerPortrait: {fileID: 0}
  - speakerName: "Maria Quit\xE9ria"
    dialogueText: "O covarde mandou seus bastardos para sabotar nossas linhas, como
      se o ex\xE9rcito portugu\xEAs j\xE1 tivesse problemas suficientes."
    speakerPortrait: {fileID: 0}
  - speakerName: "Maria Quit\xE9ria"
    dialogueText: "Ali\xE1s, prazer, sou Soldado Medeiros. Se quiser nos ajudar,
      vai precisar disso! Segure firme e, quando tentarem te cercar, avance sem medo,
      pois a espada ir\xE1 te proteger. A batalha s\xF3 est\xE1 come\xE7ando pelas
      terras da Bahia!"
    speakerPortrait: {fileID: 0}
  - speakerName: "Maria Quit\xE9ria"
    dialogueText: "Segure firme e, quando tentarem te cercar, avance sem medo, pois
      a espada ir\xE1 te proteger. A batalha s\xF3 est\xE1 come\xE7ando pelas terras
      da Bahia!"
    speakerPortrait: {fileID: 0}
