MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 361208f872750c74cbc021f057b1502a, type: 3}
  m_Name: D3 - Encontro Mahin
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogues:
  - speakerName: "Lu\xEDsa Mahin"
    dialogueText: "Olha o bolo, olha o quitute fresco para confortar a alma!...Aproxime-se,
      viajante. Seu olhar n\xE3o \xE9 daqui. Veio buscar o que n\xE3o est\xE1 escrito
      nas vitrines?"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "Vim conter a interfer\xEAncia de alguns homens de vermelho."
    speakerPortrait: {fileID: 0}
  - speakerName: "Lu\xEDsa Mahin"
    dialogueText: "Meus temores estavam certos... Um desses homens esgueirou-se pelo
      tabuleiro e roubou bilhetes que eu pretendia distribuir aos guerreiros Mal\xEAs!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: Provas materiais da revolta.
    speakerPortrait: {fileID: 0}
  - speakerName: "Lu\xEDsa Mahin"
    dialogueText: "Se as autoridades de Salvador deitarem as m\xE3os \xE0quelas cartas,
      nossa liberta\xE7\xE3o ser\xE1 sufocada antes mesmo de come\xE7ar. Eu consigo
      sentir a energia corrompida deles no ar... espere, olhe um deles al\xED!"
    speakerPortrait: {fileID: 0}
  - speakerName: Agente
    dialogueText: "Alvo em movimento. Iniciando persegui\xE7\xE3o."
    speakerPortrait: {fileID: 0}
